# Copy to .env. Docker Compose reads this file; the host script never sources it.
# Set Y only after accepting the NVIDIA license linked in README.md.
ACCEPT_EULA=N

# No project images have been published yet. These tags are built locally.
# A release can replace these with registry image references pinned by digest.
LEKIWI_SIM_IMAGE=lekiwi-sim:0.1.0
LEKIWI_LEROBOT_IMAGE=lekiwi-lerobot:0.1.0
# SO101 joint signs: shoulder_pan, shoulder_lift, elbow_flex, wrist_flex, wrist_roll, gripper.
# Validate one joint at a time on your leader before collecting data.
LEKIWI_ARM_SIGNS=1,1,1,1,1,1
# Model zero offsets in degrees, added AFTER applying signs (same joint order).
# Wrist default: clockwise 90 degrees looking from wrist toward fingertips.
# Other zero offsets are not a hardware-validated pose alignment preset.
LEKIWI_ARM_OFFSETS_DEG=0,0,0,0,-90,0
# Simulated target slew speed in rad/s of wall time; allowed (0, 10].
LEKIWI_ARM_MAX_SPEED=3.0
