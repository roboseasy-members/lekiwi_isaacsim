#!/usr/bin/env bash
# 실습은 Docker로 실행하며 install만 Ubuntu 기본 Python을 사용한다.
set -euo pipefail

readonly project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly project_name="${LEKIWI_PROJECT_NAME:-lekiwi}"
export LEKIWI_UID="$(id -u)" LEKIWI_GID="$(id -g)"
export LEKIWI_DATA_DIR="${LEKIWI_DATA_DIR:-${project_dir}/data}"

fail() { echo "ERROR: $*" >&2; exit 1; }
usage() {
    echo 'Usage: ./lekiwi COMMAND [ARGS]'
    echo '  classroom                 로컬 창으로 1~6장 실습 선택'
    echo '  remote COMMAND [ARGS]     같은 LAN의 화면·리더암 연결 (remote --help)'
    echo '  install [--check|--verify] 학생 PC 준비 / 읽기 전용 검사 / GPU 실습 검사'
    echo '  doctor                    Check Docker access, GPU and bundled assets'
    echo '  config                    Validate/render Docker Compose configuration'
    echo '  setup [sim|lerobot|all]    Build images locally (default: all)'
    echo '  pull [sim|lerobot|all]     Pull published images configured in .env'
    echo '  sim                       Open the keyboard-drive demo (X11/XWayland)'
    echo '  record                    Open LeKiwi RGB/action recording (no USB)'
    echo '  export-dataset ARGS       Convert saved recordings to a local LeRobot dataset'
    echo '  dataset-ui                브라우저에서 로컬 시연 선택·변환·데이터셋 검사'
    echo '  dataset COMMAND [ARGS]    list / export / inspect / upload'
    echo '  basic [--chapter 1..6 | --script PATH | --experiment 1..6]  학생 Python 파일 실행'
    echo '  test-recording            Check classroom recording/replay (no USB)'
    echo '  test-basic                Check classroom physics inside Docker (no USB)'
    echo '  scene [--seed N|--layout FILE] [--start-count N --middle-count N]  Open collection course'
    echo '        [--block red|orange|yellow|green --basket COLOR] Select a task'
    echo '  calibrate --port DEV --id NAME  Calibrate/reuse SO101 leader (interactive)'
    echo '  teleop --port DEV --id NAME [--record]  SO101 leader + keyboard base (interactive)'
    echo '         [--scene random|/data/scenes/course.XXXXXXXX/layout.json] Random blocks or replay'
    echo '  validate                  Check bundled URDF and meshes inside Docker'
    echo '  validate-usd              Check composed USD and physics configuration'
    echo '  test-physics              Run the headless contact-drive regression'
    echo '  test-arm                  Test six simulated joints with synthetic input (no USB)'
    echo '  test-gripper              가상 팔의 큐브 유지·이동·놓기 검사 (USB 미사용)'
    echo '  test-scene                Check course collisions, objects and basket (no USB)'
    echo '  test-cameras              코스의 두 RGB·짧은 기록 검사 (USB 미사용)'
    echo '  build-assets              Rebuild assets into a new data/asset-build.* folder'
    echo '  check-ml                  Check LeRobot imports and CUDA'
    echo '  train act|groot [ARGS]     Forward training arguments to lerobot-train'
    echo '  act train|infer [ARGS]     수업용 ACT 학습 / 저장한 ACT로 Isaac Sim 추론'
    echo '  status                    Show this project’s containers'
    echo '  stop                      Stop only this project’s simulation container'
    echo 'Recording: record / teleop --record. Local export: export-dataset. Hardware validation and policy evaluation remain separate.'
}

command_name="${1:-help}"
if (($#)); then shift; fi
if [[ "$command_name" == remote ]]; then
    exec /usr/bin/python3 -B -u "$project_dir/tools/remote_classroom/main.py" "$@"
fi
if [[ "$command_name" == classroom ]]; then
    (($# == 0)) || fail 'classroom takes no arguments.'
    exec /usr/bin/python3 -B "$project_dir/tools/classroom/main.py"
fi
if [[ "$command_name" == act ]]; then
    exec /usr/bin/python3 -B -u "$project_dir/tools/act/launch.py" "$@"
fi
case "$command_name" in
    help|-h|--help) usage; exit 0 ;;
    install|doctor|config|setup|pull|sim|record|export-dataset|dataset-ui|dataset|basic|test-basic|test-recording|scene|calibrate|teleop|validate|validate-usd|test-physics|test-arm|test-gripper|test-scene|test-cameras|build-assets|check-ml|train|status|stop) ;;
    *) usage >&2; fail "Unknown command: $command_name" ;;
esac

if [[ "$command_name" == install ]]; then
    [[ -x /usr/bin/python3 ]] || fail '학생 설치 도구에는 Ubuntu의 python3 패키지가 필요합니다.'
    exec /usr/bin/python3 -B -u "$project_dir/tools/host_setup/main.py" "$@"
fi

command -v docker >/dev/null || fail 'Install Docker Engine and the Compose plugin first.'
docker_cmd=(docker)
if [[ "${LEKIWI_DOCKER_SUDO:-0}" == 1 ]]; then
    # Preserve only the values used by Compose, including the login user's IDs.
    # Do not run this entire launcher as root or inherit an arbitrary root HOME.
    if [[ -n "${LEKIWI_CLASSROOM_SESSION:-}" ]]; then
        sudo -n -v || fail 'Run sudo -v in the launcher terminal, then retry.'
    else
        sudo -v || fail 'Could not obtain Docker sudo access.'
    fi
    docker_cmd=(sudo --preserve-env=LEKIWI_UID,LEKIWI_GID,LEKIWI_DATA_DIR,LEKIWI_SIM_IMAGE,LEKIWI_LEROBOT_IMAGE,ACCEPT_EULA,DISPLAY,LEKIWI_XAUTH_FILE,LEKIWI_LEADER_PORT,LEKIWI_LEADER_GID,LEKIWI_TELEOP_STATE,LEKIWI_TELEOP_SESSION,LEKIWI_TELEOP_REMOTE,LEKIWI_ARM_SIGNS,LEKIWI_ARM_OFFSETS_DEG,LEKIWI_ARM_MAX_SPEED,LEKIWI_COURSE_LAYOUT,LEKIWI_CAMERA_CONFIG,LEKIWI_RECORDING,LEKIWI_RECORD_SECONDS,LEKIWI_RECORD_TASK,LEKIWI_POLICY_DIR,LEKIWI_POLICY_SECONDS,LEKIWI_DISPLAY_MODE,LEKIWI_STREAM_HOST docker)
fi
compose=("${docker_cmd[@]}" compose --project-directory "$project_dir"
    --project-name "$project_name" -f "$project_dir/compose.yaml")
"${docker_cmd[@]}" compose version >/dev/null || fail 'Docker Compose plugin is required.'

if [[ "$command_name" == config ]]; then
    exec "${compose[@]}" config "$@"
fi

"${docker_cmd[@]}" info >/dev/null 2>&1 || fail \
    'Docker is not accessible. Start Docker and grant access, or run LEKIWI_DOCKER_SUDO=1 ./lekiwi <command>.'

if [[ "$command_name" == doctor ]]; then
    echo "Project: $project_dir"
    echo "Containers: $project_name"
    "${docker_cmd[@]}" version --format 'Docker server: {{.Server.Version}}'
    "${docker_cmd[@]}" compose version
    command -v nvidia-smi >/dev/null || fail 'nvidia-smi is missing. Install the NVIDIA driver.'
    nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv,noheader
    [[ -f "$project_dir/isaac_sim/assets/lekiwi_soarm/usd/lekiwi_soarm.usd" ]] || fail 'Bundled USD is missing.'
    echo 'Host checks passed. Use validate-usd and check-ml to verify container GPU access.'
    exit 0
fi

if [[ "$command_name" == status ]]; then
    exec "${compose[@]}" ps --all
fi
if [[ "$command_name" == stop ]]; then
    container_name="${project_name}-sim"
    owner="$("${docker_cmd[@]}" inspect --format '{{index .Config.Labels "com.docker.compose.project"}}|{{index .Config.Labels "com.docker.compose.project.working_dir"}}|{{index .Config.Labels "com.docker.compose.service"}}' "$container_name")" \
        || fail "No simulation container named $container_name"
    [[ "$owner" == "${project_name}|${project_dir}|sim" ]] \
        || fail "Container $container_name is not owned by this project checkout."
    if [[ -n "${LEKIWI_CLASSROOM_SESSION:-}" ]]; then
        run_owner="$("${docker_cmd[@]}" inspect --format '{{index .Config.Labels "lekiwi.classroom.session"}}' "$container_name")"
        [[ "$run_owner" == "$LEKIWI_CLASSROOM_SESSION" ]] || fail 'This container was not started by this classroom session.'
    fi
    exec "${docker_cmd[@]}" stop --time 30 "$container_name"
fi

if [[ "$command_name" == setup || "$command_name" == pull ]]; then
    target="${1:-all}"
    (($# <= 1)) || fail 'Expected at most one image target.'
    case "$target" in
        sim|lerobot) services=("$target") ;;
        all) services=(sim lerobot) ;;
        *) fail 'Image target must be sim, lerobot, or all.' ;;
    esac
    if [[ "$command_name" == setup ]]; then
        exec "${compose[@]}" build "${services[@]}"
    fi
    exec "${compose[@]}" pull "${services[@]}"
fi

[[ "$LEKIWI_DATA_DIR" == /* ]] || fail 'LEKIWI_DATA_DIR must be an absolute path.'
mkdir -p "$LEKIWI_DATA_DIR"/{captures,datasets,outputs,calibration,cache/kit,isaac-data,logs/sim,home/sim,home/lerobot}
[[ -w "$LEKIWI_DATA_DIR" ]] || fail 'The data directory is not writable by the current user.'

ensure_image() {
    local service="$1" image_name
    image_name="$("${compose[@]}" config --images "$service")"
    if ! "${docker_cmd[@]}" image inspect "$image_name" >/dev/null 2>&1; then
        case "$image_name" in
            lekiwi-sim:*|lekiwi-lerobot:*) "${compose[@]}" build "$service" ;;
            *) "${compose[@]}" pull "$service" ;;
        esac
    fi
}

if [[ "$command_name" == check-ml ]]; then
    ensure_image lerobot
    exec "${compose[@]}" run --rm --no-deps -T lerobot check --gpu "$@"
fi
if [[ "$command_name" == export-dataset ]]; then
    ensure_image lerobot
    exec "${compose[@]}" run --rm --no-deps -T -e HF_HUB_OFFLINE=1 lerobot \
        python /opt/lekiwi/tools/export_dataset.py "$@"
fi
if [[ "$command_name" == dataset-ui || "$command_name" == dataset ]]; then
    if [[ "$command_name" == dataset-ui ]]; then
        (($# == 0)) || fail 'dataset-ui takes no arguments.'
        manager_args=(serve)
        manager_run=(-T --publish 127.0.0.1:8765:8765)
    else
        case "${1:-}" in list|export|inspect|upload|-h|--help) ;; *) fail 'Use dataset list|export|inspect|upload.' ;; esac
        manager_args=("$@")
        manager_run=(-T)
    fi
    manager_offline=1
    manager_secret_fd=''
    if [[ "${manager_args[0]}" == upload ]]; then
        [[ -n "${LEKIWI_CLASSROOM_SESSION:-}" ]] \
            || fail 'Hugging Face upload is run with python3 05_upload_dataset.py in the browser VS Code terminal.'
        # 토큰을 다른 준비 명령이 읽지 않도록 전용 익명 FD에 보관하고 원래 stdin을 닫습니다.
        exec 10<&0
        exec </dev/null
        manager_secret_fd=10
        manager_offline=0
    fi
    ensure_image lerobot
    if [[ "$command_name" == dataset-ui || -n "${LEKIWI_CLASSROOM_SESSION:-}" ]]; then
        # compose run -T may detach on Ctrl+C; explicitly stop only this launch.
        manager_run_id="${BASHPID}-${RANDOM}-${RANDOM}"
        manager_container="${project_name}-dataset-ui-${manager_run_id}"
        manager_pid=''
        stop_manager() {
            local owner
            # wait 중에는 trap이 즉시 실행됩니다. 이 실행의 Compose 클라이언트도 남기지 않습니다.
            if [[ -n "$manager_pid" ]] && kill -0 "$manager_pid" 2>/dev/null; then
                kill -TERM "$manager_pid" 2>/dev/null || true
                wait "$manager_pid" 2>/dev/null || true
            fi
            owner="$("${docker_cmd[@]}" inspect --format '{{index .Config.Labels "lekiwi.dataset-manager.run"}}' "$manager_container" 2>/dev/null)" || return 0
            if [[ "$owner" == "$manager_run_id" ]]; then
                "${docker_cmd[@]}" stop --time 10 "$manager_container" >/dev/null 2>&1 || true
            fi
        }
        trap stop_manager EXIT
        trap 'exit 130' INT
        trap 'exit 143' TERM
        if [[ -n "$manager_secret_fd" ]]; then
            "${compose[@]}" run --rm --no-deps "${manager_run[@]}" -e HF_HUB_OFFLINE="$manager_offline" \
                -e HF_HUB_DISABLE_IMPLICIT_TOKEN=1 -e HF_HUB_DISABLE_TELEMETRY=1 \
                --name "$manager_container" --label "lekiwi.dataset-manager.run=$manager_run_id" lerobot \
                python /opt/lekiwi/tools/dataset_manager/cli.py "${manager_args[@]}" <&10 &
            exec 10<&-
        else
            "${compose[@]}" run --rm --no-deps "${manager_run[@]}" -e HF_HUB_OFFLINE="$manager_offline" \
                --name "$manager_container" --label "lekiwi.dataset-manager.run=$manager_run_id" lerobot \
                python /opt/lekiwi/tools/dataset_manager/cli.py "${manager_args[@]}" &
        fi
        manager_pid=$!
        wait "$manager_pid"
        exit "$?"
    fi
    if [[ -n "$manager_secret_fd" ]]; then
        exec "${compose[@]}" run --rm --no-deps "${manager_run[@]}" -e HF_HUB_OFFLINE="$manager_offline" \
            -e HF_HUB_DISABLE_IMPLICIT_TOKEN=1 -e HF_HUB_DISABLE_TELEMETRY=1 lerobot \
            python /opt/lekiwi/tools/dataset_manager/cli.py "${manager_args[@]}" <&10
    fi
    exec "${compose[@]}" run --rm --no-deps "${manager_run[@]}" -e HF_HUB_OFFLINE="$manager_offline" lerobot \
        python /opt/lekiwi/tools/dataset_manager/cli.py "${manager_args[@]}"
fi
if [[ "$command_name" == record ]]; then
    (($# == 0)) || fail 'record takes no arguments; set LEKIWI_RECORD_SECONDS and LEKIWI_RECORD_TASK before running.'
    export LEKIWI_RECORDING=1
    export LEKIWI_COURSE_LAYOUT="${LEKIWI_COURSE_LAYOUT:-random}"
fi
if [[ "$command_name" == train ]]; then
    policy="${1:-}"
    [[ "$policy" == act || "$policy" == groot ]] || fail 'Choose train act or train groot.'
    shift
    ensure_image lerobot
    exec "${compose[@]}" run --rm --no-deps -T lerobot lerobot-train \
        "--policy.type=$policy" --policy.push_to_hub=false --wandb.enable=false "$@"
fi

if [[ "$command_name" == calibrate || "$command_name" == teleop ]]; then
    leader_port='' leader_id=''
    while (($#)); do
        case "$1" in
            --record)
                [[ "$command_name" == teleop ]] || fail '--record is only for teleop'
                export LEKIWI_RECORDING=1; shift ;;
            --port) (($# >= 2)) || fail '--port needs a device'; leader_port="$2"; shift 2 ;;
            --id) (($# >= 2)) || fail '--id needs a stable name'; leader_id="$2"; shift 2 ;;
            --scene)
                [[ "$command_name" == teleop ]] || fail '--scene is only for teleop'
                (($# >= 2)) || fail '--scene needs random or a saved /data/.../layout.json'
                [[ "$2" == random || "$2" == /data/* ]] || fail '--scene must be random or a container /data/.../layout.json path'
                export LEKIWI_COURSE_LAYOUT="$2"; shift 2 ;;
            *) fail "Unexpected SO101 argument: $1" ;;
        esac
    done
    [[ "$leader_id" =~ ^[A-Za-z0-9_-]+$ ]] || fail 'Set --id using letters, digits, underscore or hyphen.'
    [[ -t 0 && -t 1 ]] || fail 'SO101 requires an interactive terminal for calibration and safety confirmation.'
    export LEKIWI_LEADER_PORT="$(readlink -f -- "$leader_port")"
    [[ "$LEKIWI_LEADER_PORT" =~ ^/dev/tty(ACM|USB)[0-9]+$ && -c "$LEKIWI_LEADER_PORT" ]] \
        || fail 'Select an existing SO101 /dev/serial/by-id/... or /dev/ttyACM*/ttyUSB* device.'
    export LEKIWI_LEADER_GID="$(stat -c '%g' -- "$LEKIWI_LEADER_PORT")"
    # A host device lock also excludes this launcher's other checkouts/projects.
    command -v flock >/dev/null || fail 'flock (util-linux) is required for exclusive leader access.'
    lock_dir="/tmp/lekiwi-device-locks-$(id -u)"
    (umask 077; mkdir -p "$lock_dir")
    [[ -O "$lock_dir" && ! -L "$lock_dir" ]] || fail 'Unsafe device lock directory.'
    exec 9>>"$lock_dir/$(stat -c '%t-%T' -- "$LEKIWI_LEADER_PORT").lock"
    flock -n 9 || fail 'This leader device is already in use by another launcher.'
    compose+=(-f "$project_dir/docker/compose.leader.yaml")
    if [[ "$command_name" == teleop ]]; then
        "${compose[@]}" config --environment | grep -x 'ACCEPT_EULA=Y' >/dev/null \
            || fail 'Read the Isaac Sim license and set ACCEPT_EULA=Y before teleop.'
    fi
    existing="$("${docker_cmd[@]}" ps -q --filter "label=com.docker.compose.project=$project_name" --filter label=com.docker.compose.service=leader)"
    [[ -z "$existing" ]] || fail 'A SO101 leader container is already running.'
    ensure_image lerobot
    if [[ "$command_name" == calibrate ]]; then
        exec "${compose[@]}" run --rm --no-deps --name "${project_name}-leader" leader \
            python /opt/lekiwi/tools/so101_leader.py --id "$leader_id" --calibrate-only
    fi
fi

running="$("${docker_cmd[@]}" ps -q \
    --filter "label=com.docker.compose.project=$project_name" \
    --filter 'label=com.docker.compose.service=sim')"
[[ -z "$running" ]] || fail 'A simulation is already running. Close it or use ./lekiwi stop first.'

case "$command_name" in
    sim|record|teleop) sim_command=keyboard ;;
    basic) sim_command=basic ;;
    test-basic) sim_command=basic-test ;;
    test-recording) sim_command=recording-test ;;
    scene) sim_command=course ;;
    validate) sim_command=validate-assets ;;
    validate-usd) sim_command=validate-usd ;;
    test-physics) sim_command=physics-test ;;
    test-arm) sim_command=arm-test ;;
    test-gripper) sim_command=gripper-test ;;
    test-scene) sim_command=course-test ;;
    test-cameras) sim_command=camera-test ;;
    build-assets) sim_command=build-assets ;;
esac

auth_dir=''
teleop_children=()
teleop_names=()
cleanup() {
    local name owner child index attempt
    for index in "${!teleop_names[@]}"; do
        name="${teleop_names[$index]}"
        child="${teleop_children[$index]:-}"
        # A peer may fail while this container is still being created. Wait for
        # its running label, but never wait forever for an interactive prompt.
        for ((attempt=0; attempt<50; attempt++)); do
            owner="$("${docker_cmd[@]}" inspect --format '{{index .Config.Labels "lekiwi.teleop.session"}}|{{.State.Running}}' "$name" 2>/dev/null)" || owner=''
            if [[ "$owner" == "${LEKIWI_TELEOP_SESSION:-}|true" ]]; then
                "${docker_cmd[@]}" stop --time 10 "$name" >/dev/null 2>&1 || true
                break
            fi
            [[ -n "$child" ]] && kill -0 "$child" 2>/dev/null || break
            sleep 0.2
        done
        if [[ -n "$child" ]] && kill -0 "$child" 2>/dev/null; then
            kill -TERM "$child" 2>/dev/null || true
        fi
    done
    for child in "${teleop_children[@]}"; do wait "$child" 2>/dev/null || true; done
    # Only remove the temporary cookie created by this invocation.
    if [[ -n "$auth_dir" ]]; then
        rm -f -- "$auth_dir/Xauthority"
        rmdir -- "$auth_dir"
    fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
if [[ "$command_name" == sim || "$command_name" == record || "$command_name" == teleop || "$command_name" == scene || "$command_name" == basic ]]; then
  if [[ "${LEKIWI_DISPLAY_MODE:-local}" == webrtc ]]; then
    [[ -n "${LEKIWI_STREAM_HOST:-}" ]] || fail 'Set LEKIWI_STREAM_HOST to the desktop IPv4 address.'
    compose+=(-f "$project_dir/docker/compose.stream.yaml")
  else
    command -v xauth >/dev/null || fail 'Install xauth on the host for GUI authentication.'
    [[ "${DISPLAY:-}" =~ ^:([0-9]+)(\.[0-9]+)?$ ]] \
        || fail 'Set DISPLAY to a local X11/XWayland display, such as :0 or :1.'
    [[ -S "/tmp/.X11-unix/X${BASH_REMATCH[1]}" ]] || fail 'The selected X11 socket does not exist.'
    auth_source="${XAUTHORITY:-}"
    if [[ -z "$auth_source" ]]; then
        for candidate in "${HOME}/.Xauthority" "/run/user/$(id -u)/gdm/Xauthority"; do
            if [[ -r "$candidate" ]]; then auth_source="$candidate"; break; fi
        done
    fi
    [[ -r "$auth_source" ]] || fail 'Set XAUTHORITY to the readable cookie file for your display.'
    auth_dir="$(mktemp -d /tmp/lekiwi-xauth.XXXXXXXX)"
    export LEKIWI_XAUTH_FILE="$auth_dir/Xauthority"
    touch "$LEKIWI_XAUTH_FILE"
    chmod 600 "$LEKIWI_XAUTH_FILE"
    # FamilyWild permits the cookie in the container without xhost + access.
    xauth -f "$auth_source" nlist "$DISPLAY" | sed 's/^..../ffff/' \
        | xauth -f "$LEKIWI_XAUTH_FILE" nmerge -
    [[ -s "$LEKIWI_XAUTH_FILE" ]] || fail 'No X11 cookie was found for this display.'
    compose+=(-f "$project_dir/docker/compose.gui.yaml")
  fi
fi

compose+=(-f "$project_dir/docker/compose.basic.yaml")
ensure_image sim
if [[ "$command_name" == teleop ]]; then
    # Fresh directory prevents replaying a sample from an earlier run.
    mkdir -p "$LEKIWI_DATA_DIR/teleop"
    session_dir="$(mktemp -d "$LEKIWI_DATA_DIR/teleop/session.XXXXXXXX")"
    export LEKIWI_TELEOP_SESSION="${session_dir##*/}"
    export LEKIWI_TELEOP_STATE="/data/teleop/$LEKIWI_TELEOP_SESSION/leader.json"
    teleop_names=("${project_name}-leader" "${project_name}-sim")
    echo "SO101 calibration prompts appear here. Simulator log: $session_dir/sim.log"
    echo 'Close the simulator or press Ctrl+C here to stop this session.'
    "${compose[@]}" run --rm --no-deps --name "${project_name}-leader" \
        --label "lekiwi.teleop.session=$LEKIWI_TELEOP_SESSION" leader \
        python /opt/lekiwi/tools/so101_leader.py --id "$leader_id" \
        --state "$LEKIWI_TELEOP_STATE" --session "$LEKIWI_TELEOP_SESSION" < /dev/tty &
    teleop_children+=("$!")
    # GUI stays disarmed while calibration is in progress; its log cannot obscure prompts.
    "${compose[@]}" run --rm --no-deps -T --name "${project_name}-sim" \
        --label "lekiwi.teleop.session=$LEKIWI_TELEOP_SESSION" sim keyboard > "$session_dir/sim.log" 2>&1 &
    teleop_children+=("$!")
    result=0
    wait -n "${teleop_children[@]}" || result=$?
    exit "$result"
fi
classroom_args=()
if [[ -n "${LEKIWI_CLASSROOM_SESSION:-}" ]]; then
    classroom_args=(--label "lekiwi.classroom.session=$LEKIWI_CLASSROOM_SESSION")
fi
"${compose[@]}" run --rm --no-deps -T --name "${project_name}-sim" "${classroom_args[@]}" sim "$sim_command" "$@"
